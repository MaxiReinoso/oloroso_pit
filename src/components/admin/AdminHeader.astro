---
/**
 * Encabezado del área de administración. No lleva barra de anuncio ni la
 * navegación principal pública: el acceso se habilita en C-13.
 */
import logoUrl from '../../../design-system/assets/logo.svg?url';
---

<header class="admin-header">
  <div class="container admin-header__inner">
    <a class="admin-header__brand" href="/" aria-label="Oloroso Pit — volver al sitio público">
      <img
        src={logoUrl}
        alt="Oloroso Pit. Marca provisional."
        width="160"
        height="44"
      />
    </a>

    <p class="admin-header__label">Administración</p>

    <a class="admin-header__exit" href="/">Ver sitio público</a>
  </div>
</header>

<style>
  .admin-header {
    background: var(--color-primary-900);
    color: var(--color-accent-100);
    border-bottom: 3px solid var(--color-accent-600);
  }

  .admin-header__inner {
    display: flex;
    align-items: center;
    gap: var(--space-4);
    min-height: 72px;
    padding-block: var(--space-2);
  }

  .admin-header__brand {
    display: inline-flex;
    align-items: center;
    flex: none;
    text-decoration: none;
  }

  .admin-header__brand img {
    height: 40px;
    width: auto;
  }

  .admin-header__label {
    margin: 0;
    padding: 4px 10px;
    border: 1px solid var(--color-accent-600);
    border-radius: var(--radius-pill);
    font-size: var(--text-2xs);
    font-weight: var(--weight-bold);
    letter-spacing: var(--tracking-caps);
    text-transform: uppercase;
    color: var(--color-accent-600);
  }

  .admin-header__exit {
    margin-left: auto;
    display: inline-flex;
    align-items: center;
    min-height: 40px;
    padding-inline: var(--space-3);
    border-radius: var(--radius-sm);
    color: var(--color-accent-100);
    font-size: var(--text-sm);
    font-weight: var(--weight-semibold);
    text-decoration: underline;
    text-decoration-thickness: 2px;
    text-underline-offset: 4px;
  }

  .admin-header__exit:focus-visible {
    outline-color: var(--color-focus-on-dark);
  }

  @media (max-width: 620px) {
    .admin-header__inner {
      min-height: 64px;
      gap: var(--space-2);
    }

    .admin-header__brand img {
      height: 32px;
    }

    .admin-header__label {
      display: none;
    }
  }
</style>
