---
/**
 * Encabezado del área de administración: marca, alcance y barra de sesión.
 *
 * La sesión (email + «Cerrar sesión») es una isla React: el email sale de la
 * sesión real, nunca de un valor fijo en el código.
 */
import logoUrl from '../../../design-system/assets/logo.svg?url';
import SessionBar from './SessionBar.tsx';
---

<header class="admin-header">
  <div class="admin-header__inner">
    <a class="admin-header__brand" href="/" aria-label="Oloroso Pit — volver al sitio público">
      <img
        src={logoUrl}
        alt="Oloroso Pit. Marca provisional."
        width="160"
        height="44"
      />
    </a>

    <p class="admin-header__label">Administración</p>

    <SessionBar client:load />
  </div>
</header>

<style>
  .admin-header {
    background: var(--color-primary-900);
    color: var(--color-accent-100);
    border-bottom: 3px solid var(--color-accent-600);
  }

  .admin-header__inner {
    display: flex;
    align-items: center;
    gap: var(--space-3);
    width: min(100% - var(--space-6), var(--container-max));
    margin-inline: auto;
    min-height: 72px;
    padding-block: var(--space-2);
  }

  .admin-header__brand {
    display: inline-flex;
    align-items: center;
    flex: none;
    text-decoration: none;
  }

  .admin-header__brand img {
    height: 38px;
    width: auto;
  }

  .admin-header__label {
    margin: 0;
    padding: 4px 10px;
    border: 1px solid var(--color-accent-600);
    border-radius: var(--radius-pill);
    font-size: var(--text-2xs);
    font-weight: var(--weight-bold);
    letter-spacing: var(--tracking-caps);
    text-transform: uppercase;
    white-space: nowrap;
    color: var(--color-accent-600);
  }

  @media (max-width: 620px) {
    .admin-header__inner {
      min-height: 64px;
      gap: var(--space-2);
    }

    .admin-header__brand img {
      height: 30px;
    }

    .admin-header__label {
      display: none;
    }
  }
</style>
