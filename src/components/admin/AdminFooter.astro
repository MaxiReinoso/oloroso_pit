---
/**
 * Pie del área de administración. Sin navegación pública ni enlaces al sitio:
 * el shell de administración solo declara su alcance.
 */
---

<footer class="admin-footer">
  <div class="container admin-footer__inner">
    <span>© 2026 Oloroso Pit · Área de administración</span>
  </div>
</footer>

<style>
  .admin-footer {
    margin-top: auto;
    background: var(--color-surface);
    border-top: 2px solid var(--color-line-strong);
    color: var(--color-ink-soft);
  }

  .admin-footer__inner {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    min-height: 56px;
    padding-block: var(--space-3);
    font-size: var(--text-xs);
    font-weight: var(--weight-semibold);
  }
</style>
