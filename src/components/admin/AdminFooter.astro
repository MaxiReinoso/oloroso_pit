---
/**
 * Pie del área de administración. Mantiene el alcance del panel y ofrece la
 * vuelta al sitio público.
 */
---

<footer class="admin-footer">
  <div class="admin-footer__inner">
    <span>© 2026 Oloroso Pit · Área de administración</span>
    <a class="admin-footer__link" href="/">Ver el sitio público</a>
  </div>
</footer>

<style>
  .admin-footer {
    margin-top: auto;
    color: var(--color-ink-soft);
  }

  .admin-footer__inner {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-2) var(--space-4);
    width: min(100% - var(--space-6), var(--container-max));
    margin-inline: auto;
    padding-block: var(--space-4);
    border-top: 2px solid var(--color-primary-700);
    font-size: var(--text-xs);
  }

  .admin-footer__link {
    display: inline-flex;
    align-items: center;
    min-height: 40px;
    color: var(--color-ink-soft);
    text-decoration: underline;
    text-decoration-thickness: 2px;
    text-underline-offset: 3px;
  }
</style>
