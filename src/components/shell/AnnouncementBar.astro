---
/**
 * Barra de anuncio del shell público: la primera línea que ve el visitante y
 * el recordatorio de que el pedido se cierra fuera del sitio.
 */
---

<div class="announce">
  <div class="container announce__inner">
    <span>Perfumes importados · pedidos por WhatsApp</span>
    <span aria-hidden="true">•</span>
    <a href="/perfumes">Ver catálogo</a>
  </div>
</div>

<style>
  .announce {
    background: var(--color-accent-600);
    color: var(--color-primary-700);
    border-bottom: 2px solid var(--color-primary-700);
    font-size: var(--text-xs);
    font-weight: var(--weight-bold);
    letter-spacing: var(--tracking-wide);
  }

  .announce__inner {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: center;
    gap: var(--space-1) var(--space-3);
    min-height: 34px;
    padding-block: 6px;
    text-align: center;
  }

  .announce__inner span[aria-hidden] {
    opacity: 0.55;
  }

  .announce a {
    color: var(--color-primary-700);
    text-underline-offset: 3px;
    text-decoration-thickness: 2px;
  }

  @media (max-width: 620px) {
    .announce {
      font-size: var(--text-2xs);
    }
  }
</style>
