---
import PublicLayout from '../layouts/PublicLayout.astro';
---

<PublicLayout>
  <section class="hero" aria-labelledby="hero-title">
    <div class="container hero__inner">
      <p class="hero__eyebrow">Por encargo y en stock</p>
      <h1 id="hero-title">Perfumes importados, sin vueltas.</h1>
      <p class="hero__lead">
        Precio y disponibilidad siempre a la vista. Armá tu pedido y enviálo por
        WhatsApp: comprá lo que está en stock o encargá lo que falta.
      </p>
      <div class="hero__actions">
        <a class="btn btn--primary" href="/perfumes">
          Ver catálogo
          <svg
            width="18"
            height="18"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="2.6"
            stroke-linecap="round"
            stroke-linejoin="round"
            aria-hidden="true"
            focusable="false"
          >
            <path d="M5 12h13M13 6l6 6-6 6"></path>
          </svg>
        </a>
        <a class="btn btn--ghost" href="#como-comprar">Cómo comprar</a>
      </div>
      <ul class="hero__facts">
        <li>Precios en pesos</li>
        <li>Decants de 5 y 10 ml</li>
        <li>No se paga en el sitio</li>
      </ul>
    </div>
  </section>

  <section class="section" id="como-comprar" aria-labelledby="como-title">
    <div class="container">
      <div class="section__head">
        <p class="eyebrow">Cómo comprar</p>
        <h2 id="como-title">Tres pasos, un mensaje</h2>
      </div>

      <div class="trust">
        <div class="trust__item">
          <span class="trust__icon" aria-hidden="true">
            <svg
              width="22"
              height="22"
              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
              stroke-width="2.2"
              stroke-linecap="round"
              focusable="false"
            >
              <path d="M4 6h16M4 12h16M4 18h10"></path>
            </svg>
          </span>
          <div>
            <h3>Precio siempre visible</h3>
            <p>El precio del frasco sellado está en cada tarjeta, haya stock o no.</p>
          </div>
        </div>

        <div class="trust__item">
          <span class="trust__icon" aria-hidden="true">
            <svg
              width="22"
              height="22"
              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
              stroke-width="2.2"
              stroke-linecap="round"
              stroke-linejoin="round"
              focusable="false"
            >
              <path d="M3 6h11v12H3zM14 10h4l3 3v5h-7z"></path>
              <circle cx="7" cy="18" r="1.6"></circle>
              <circle cx="17" cy="18" r="1.6"></circle>
            </svg>
          </span>
          <div>
            <h3>Compra o encargo</h3>
            <p>Lo que está en stock se compra; lo que falta se encarga. Se separan solos.</p>
          </div>
        </div>

        <div class="trust__item">
          <span class="trust__icon" aria-hidden="true">
            <svg
              width="22"
              height="22"
              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
              stroke-width="2.2"
              stroke-linecap="round"
              stroke-linejoin="round"
              focusable="false"
            >
              <path d="M20 11.5a7.5 7.5 0 0 1-11 6.7L4 20l1.8-4.6A7.5 7.5 0 1 1 20 11.5Z"></path>
              <path d="M9 10.5c0 .8.6 1.5 1.5 1.5H12"></path>
            </svg>
          </span>
          <div>
            <h3>Pedido por WhatsApp</h3>
            <p>Se abre WhatsApp con el pedido armado. No se paga en el sitio.</p>
          </div>
        </div>
      </div>
    </div>
  </section>
</PublicLayout>

<style>
  /* Hero ------------------------------------------------------------------ */
  .hero {
    position: relative;
    overflow: hidden;
    background: var(--color-paper);
    color: var(--color-ink);
    border-bottom: 3px solid var(--color-primary-700);
  }

  .hero::before {
    content: '';
    position: absolute;
    inset: 0;
    background-image: radial-gradient(
      var(--color-primary-700) 1.5px,
      transparent 1.7px
    );
    background-size: 22px 22px;
    opacity: 0.1;
    pointer-events: none;
  }

  .hero::after {
    content: '';
    position: absolute;
    width: 460px;
    height: 460px;
    right: -120px;
    top: -140px;
    border: 3px solid var(--color-primary-700);
    border-radius: 50%;
    opacity: 0.16;
    pointer-events: none;
  }

  .hero__inner {
    position: relative;
    z-index: 1;
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    gap: var(--space-4);
    padding-block: clamp(var(--space-6), 7vw, var(--space-9));
  }

  .hero__eyebrow {
    display: inline-flex;
    align-items: center;
    justify-self: start;
    gap: var(--space-2);
    margin: 0;
    padding: 5px 12px;
    border: 2px solid var(--color-primary-700);
    border-radius: var(--radius-pill);
    background: var(--color-primary-700);
    color: var(--color-accent-600);
    font-size: var(--text-2xs);
    font-weight: var(--weight-bold);
    letter-spacing: var(--tracking-caps);
    text-transform: uppercase;
  }

  .hero h1 {
    margin: 0;
    max-width: 18ch;
    color: var(--title-fill);
    font-family: var(--font-display);
    font-size: clamp(2.5rem, 1.2rem + 4.6vw, 4rem);
    font-weight: var(--weight-bold);
    line-height: 1.04;
    letter-spacing: 0.005em;
    -webkit-text-stroke: var(--title-stroke-lg);
    paint-order: stroke fill;
    text-shadow: var(--title-extrude-lg);
    text-wrap: balance;
  }

  .hero__lead {
    margin: 0;
    max-width: 56ch;
    color: var(--color-ink-soft);
    font-size: clamp(var(--text-base), 0.9rem + 0.35vw, var(--text-lg));
    line-height: var(--leading-relaxed);
  }

  .hero__actions {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-3);
    margin-top: var(--space-3);
  }

  .btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: var(--space-2);
    min-height: 52px;
    padding-inline: var(--space-5);
    border: 2px solid var(--color-primary-700);
    border-radius: var(--radius-sm);
    font-family: var(--font-sans);
    font-size: var(--text-base);
    font-weight: var(--weight-bold);
    line-height: var(--leading-none);
    text-decoration: none;
    cursor: pointer;
    transition:
      transform var(--duration-fast) var(--ease-out),
      box-shadow var(--duration-fast) var(--ease-out),
      background-color var(--duration-fast) var(--ease-standard);
  }

  .btn--primary {
    background: var(--color-accent-600);
    color: var(--color-primary-700);
    box-shadow: 0 5px 0 0 var(--color-primary-900);
  }

  .btn--primary:hover {
    transform: translateY(-2px);
    box-shadow: 0 7px 0 0 var(--color-primary-900);
  }

  .btn--primary:active {
    transform: translateY(2px);
    box-shadow: 0 2px 0 0 var(--color-primary-900);
  }

  .btn--ghost {
    background: transparent;
    border-color: var(--color-primary-700);
    color: var(--color-primary-700);
  }

  .btn--ghost:hover {
    background: var(--color-primary-050);
  }

  .btn--ghost:focus-visible {
    outline-color: var(--color-accent-600);
  }

  .hero__facts {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2) var(--space-4);
    margin: var(--space-2) 0 0;
    padding: 0;
    list-style: none;
    font-size: var(--text-xs);
    font-weight: var(--weight-semibold);
    color: var(--color-ink-soft);
  }

  .hero__facts li {
    display: inline-flex;
    align-items: center;
    gap: 7px;
  }

  .hero__facts li::before {
    content: '';
    width: 8px;
    height: 8px;
    border-radius: 50%;
    background: var(--color-primary-700);
    flex: none;
  }

  /* Sección --------------------------------------------------------------- */
  .section {
    padding-block: clamp(var(--space-6), 6vw, var(--space-8));
  }

  .section__head {
    display: flex;
    flex-direction: column;
    gap: var(--space-2);
    margin-bottom: var(--space-5);
  }

  .eyebrow {
    margin: 0;
    color: var(--color-ink-soft);
    font-size: var(--text-2xs);
    font-weight: var(--weight-bold);
    letter-spacing: var(--tracking-caps);
    text-transform: uppercase;
  }

  .section__head h2 {
    margin: 0;
    color: var(--color-primary-700);
    font-family: var(--font-display);
    font-size: clamp(var(--text-2xl), 1.4rem + 1.6vw, var(--text-3xl));
    font-weight: var(--weight-semibold);
    line-height: var(--leading-tight);
  }

  /* Franja de confianza --------------------------------------------------- */
  .trust {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: var(--space-4);
  }

  .trust__item {
    display: flex;
    gap: var(--space-3);
    padding: var(--space-4);
    border-radius: var(--radius-lg);
    background: var(--color-surface);
    border: 2px solid var(--color-line-strong);
  }

  .trust__icon {
    display: grid;
    place-items: center;
    width: 44px;
    height: 44px;
    flex: none;
    border-radius: var(--radius-sm);
    background: var(--color-accent-600);
    color: var(--color-primary-700);
  }

  .trust__item h3 {
    margin: 0;
    font-family: var(--font-display);
    font-size: var(--text-base);
    font-weight: var(--weight-semibold);
    line-height: var(--leading-tight);
  }

  .trust__item p {
    margin: 3px 0 0;
    font-size: var(--text-xs);
    color: var(--color-ink-soft);
    line-height: var(--leading-snug);
  }

  @media (max-width: 900px) {
    .trust {
      grid-template-columns: minmax(0, 1fr);
    }
  }

  @media (max-width: 620px) {
    .hero h1 {
      font-size: clamp(2.25rem, 1.2rem + 7vw, 2.9rem);
      -webkit-text-stroke-width: 1px;
      text-shadow: var(--title-extrude);
    }

    .btn {
      width: 100%;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .btn {
      transition: none;
    }

    .btn--primary:hover,
    .btn--primary:active {
      transform: none;
    }
  }
</style>
