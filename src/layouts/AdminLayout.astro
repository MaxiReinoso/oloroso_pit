---
/**
 * Layout del área de administración: encabezado y pie propios, sin barra de
 * anuncio ni navegación principal pública. Comparte los tokens visuales del
 * sitio.
 *
 * El guard (`AdminGuard`, isla React) es UX, no seguridad: el contenido nace
 * con `hidden` y solo se revela cuando el token se valida contra el servidor.
 * La autoridad de los datos es RLS en la base.
 */
import brandScript from '../../design-system/brand.js?url';
import logoUrl from '../../design-system/assets/logo.svg?url';
import AdminFooter from '../components/admin/AdminFooter.astro';
import AdminGuard from '../components/admin/AdminGuard.tsx';
import AdminHeader from '../components/admin/AdminHeader.astro';
import '../styles/global.css';
import '../styles/admin.css';

interface Props {
  title?: string;
}

const { title = 'Administración — Oloroso Pit' } = Astro.props;
---

<!doctype html>
<html lang="es">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="robots" content="noindex" />
    <link rel="icon" type="image/svg+xml" href={logoUrl} />
    <slot name="head" />
  </head>
  <body class="admin-body">
    <AdminHeader />

    <div class="admin-guard-slot">
      <AdminGuard client:load />
    </div>

    <main id="main" class="admin-main" data-admin-content hidden>
      <slot />
    </main>

    <AdminFooter />

    <script is:inline src={brandScript}></script>
  </body>
</html>

<style>
  .admin-body {
    display: flex;
    flex-direction: column;
    background: var(--color-paper);
  }

  .admin-guard-slot:empty {
    display: none;
  }

  .admin-main {
    flex: 1;
  }

  .admin-main[hidden] {
    display: none;
  }
</style>
