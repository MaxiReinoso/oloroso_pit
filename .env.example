# Copiá este archivo a `.env` y completá los valores de tu proyecto Supabase.
# `.env` está ignorado por git; este archivo de ejemplo sí se versiona.
# Solo variables PUBLIC_*: todo lo que empieza con PUBLIC_ termina en el bundle
# del navegador. Nunca pongas acá la service_role key.

PUBLIC_SUPABASE_URL=https://your-project.supabase.co
PUBLIC_SUPABASE_ANON_KEY=your-anon-key
